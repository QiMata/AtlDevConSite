            <!-- Workshop 1: Tim Rayburn -->
            <div class="col-xs-12 col-md-6">
              <div style="background-color: #fff; border: 3px solid #e74c3c; border-radius: 10px; padding: 30px; margin-bottom: 30px; height: 100%; display: flex; flex-direction: column;">
