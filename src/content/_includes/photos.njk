<!--PHOTO GALLERY-->
<section>
  <div id="lgx-photo-gallery" class="lgx-photo-gallery">
    <div class="lgx-inner">
      <div class="container">
        <div class="row">
          <div class="col-xs-12">
            <div class="lgx-heading-area">
              <h2 class="lgx-heading" style="margin-top:0;margin-bottom:2rem;">
                <span class="heading" style="position:static;display:block;line-height:1.2;">Photo Gallery</span>
              </h2>
              <p class="text">
                                Thank you to everyone who joined us in 2026 — here are some of our favorite moments.
                            </p>
            </div>
          </div>
        </div>
        <!--//.ROW-->
      </div>
      <!-- //.CONTAINER -->
    </div>
    <div id="lgx-memorisinner" class="lgx-memorisinner">
      <style>
        .gallery-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 8px; padding: 0 8px 70px; }
        .gallery-item { display: block; aspect-ratio: 4 / 3; overflow: hidden; background: #222; }
        .gallery-item img { width: 100%; height: 100%; object-fit: cover; object-position: center 15%; transition: transform .3s; }
        .gallery-item:hover img { transform: scale(1.06); }
      </style>
      <div class="container-fluid">
        <div class="gallery-grid">
          {% for n in range(1, 73) %}
          {% set num = "0" + n if n < 10 else n %}
          <a class="gallery-item" href="/assets/img/gallery/photo-{{ num }}.jpg" title="Atlanta Developers' Conference 2026">
            <img src="/assets/img/gallery/photo-{{ num }}.jpg" alt="Atlanta Developers' Conference 2026 photo {{ n }}" loading="lazy"/>
          </a>
          {% endfor %}
        </div>
      </div>
      <!--//.CONAINER-->
    </div>
    <!--//.lgx CONTACT INNER-->
  </div>
</section>
<!--PHOTO GALLERY END-->