<!--BANNER-->
<section>
<style>
  .lgx-banner-slides { position: absolute; inset: 0; overflow: hidden; z-index: 0; }
  .lgx-banner-slides span { position: absolute; inset: 0; background-size: cover; background-position: center; opacity: 0; transform: scale(1.08); animation: bannerFade 24s infinite; }
  .lgx-banner-slides span:nth-child(2) { animation-delay: 6s; }
  .lgx-banner-slides span:nth-child(3) { animation-delay: 12s; }
  .lgx-banner-slides span:nth-child(4) { animation-delay: 18s; }
  .lgx-banner-slides::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(20,28,38,.75), rgba(20,28,38,.45) 45%, rgba(20,28,38,.9)); box-shadow: inset 0 0 160px rgba(0,0,0,.6); }
  .lgx-banner-gradient { position: relative; }
  .lgx-banner-gradient .lgx-banner-style { position: relative; z-index: 1; }
  .banner-info { text-shadow: 0 4px 24px rgba(0,0,0,.55); }
  @keyframes bannerFade { 0% { opacity: 0; transform: scale(1.08); } 8%, 25% { opacity: 1; } 33% { opacity: 0; transform: scale(1); } 100% { opacity: 0; } }
</style>
  <div class="lgx-banner lgx-banner-gradient bg-devcon">
    <div class="lgx-banner-slides" aria-hidden="true">
      <span style="background-image:url(/assets/img/gallery/photo-05.jpg)"></span>
      <span style="background-image:url(/assets/img/gallery/photo-20.jpg)"></span>
      <span style="background-image:url(/assets/img/gallery/photo-71.jpg)"></span>
      <span style="background-image:url(/assets/img/gallery/photo-44.jpg)"></span>
    </div>
    <div class="lgx-banner-style bg-transparent">
      <div class="lgx-inner bg-transparent">
        <div class="container">
          <div class="row">
            <div class="col-xs-12">
              <div class="banner-info">
                <img src="assets/svg/atldevcon-logo-white.svg" class="logo" alt="Atlanta Developers' Conference Logo"/>
                <h2 class="title">Atlanta <span style="color:#0099cc">Developers'</span> Conference</h2>
                {# <h2 class="title">Atlanta <span style="color:#0099cc">Cloud</span> Conference</h2> #}
                {# <h2 class="date">
                   <span>{{ site.eventDate | formatDate }}</span>
                </h2> #}
                {# CONFERENCE OVER: countdown stopped; restore with next year's date in site.json.
                 <div class="circular-countdown-area">
                  <div id="circular-countdown" data-date="{{ site.eventDate | formatISO("P") }}" ></div>
                </div>
                #}
                <h3 class="date" style="margin-top:30px;"><span>Thank you for joining us! See you next year.</span></h3>
              </div>
            </div>
          </div>
          <!--//.ROW-->
        </div>
        <!-- //.CONTAINER -->
      </div>
      <!-- //.INNER -->
    </div>
  </div>
</section>
<!--BANNER END-->